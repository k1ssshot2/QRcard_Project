<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="90dp"
    android:paddingHorizontal="45dp"
    android:background="#E3E3E3">

    <ImageView
        android:id="@+id/profile"
        android:layout_width="80dp"
        android:layout_height="70dp"
        android:src="@drawable/ic_default_pic"
        android:clipToOutline="true"
        android:contentDescription="프로필 이미지"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/myName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="User Name"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/profile"
        app:layout_constraintTop_toTopOf="@+id/profile"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp" />

    <TextView
        android:id="@+id/myEmail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="username@email.com"
        app:layout_constraintStart_toStartOf="@+id/myName"
        app:layout_constraintTop_toBottomOf="@+id/myName"
        app:layout_constraintEnd_toEndOf="@+id/myName" />

    <TextView
        android:id="@+id/myNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="000-0000-0000"
        app:layout_constraintStart_toStartOf="@+id/myEmail"
        app:layout_constraintTop_toBottomOf="@+id/myEmail"
        app:layout_constraintEnd_toEndOf="@+id/myEmail" />

    <FrameLayout
        android:id="@+id/qr_frame"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="#EEEEEE"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/myNumber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            layout="@layout/qr_imageview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@null"
        android:contentDescription="Close Button"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/qr_frame"
        android:layout_marginTop="30dp"/>


</androidx.constraintlayout.widget.ConstraintLayout>